#!/bin/sh
# Fast path for Waybar's image modules: print the icon path and tooltip for one
# taskbar slot. taskbar-watch keeps these files up to date.
#
# This exists so a bar refresh does not start ten Python interpreters.

slot="${1:-}"
case "$slot" in
    ''|*[!0-9]*) exit 1 ;;
esac

dir="${XDG_CACHE_HOME:-$HOME/.cache}/waybar-taskbar"
path="$(cat "$dir/slot-$slot.path" 2>/dev/null)"

printf '%s\n' "${path:-$dir/empty.png}"

tooltip="$(cat "$dir/slot-$slot.tooltip" 2>/dev/null)"
[ -n "$tooltip" ] && printf '%s\n' "$tooltip"

exit 0

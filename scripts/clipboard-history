#!/usr/bin/env python3
"""Windows-style clipboard history (Win+V) for Wayland.

Reads cliphist's history, shows it in Rofi (with image thumbnails), and puts
the chosen item back on the clipboard as its original MIME type.

Keys inside the picker:
    Enter              paste selected item into the focused app
    Ctrl+Delete        delete selected item
    Ctrl+Shift+Delete  clear the whole history

Selecting an item copies it to the clipboard and immediately sends the paste
shortcut to the focused window (Ctrl+V, or Ctrl+Shift+V in terminals), the
same way Windows' Win+V behaves.
"""

from __future__ import annotations

import io
import json
import shutil
import subprocess
import tempfile
import time
from pathlib import Path

ROFI = [
    "rofi",
    "-dmenu",
    "-i",
    "-no-custom",
    "-p",
    "Clipboard",
    "-font",
    "JetBrains Mono 9",
    "-mesg",
    "Enter: paste   Ctrl+Del: del   Ctrl+Shift+Del: clear",
    "-theme-str",
    "window {width: 400px; padding: 6px;} "
    "mainbox {children: [inputbar, message, listview]; spacing: 5px;} "
    "inputbar {padding: 6px 9px; border-radius: 8px;} "
    "entry {placeholder: \"Search clipboard\";} "
    "message {padding: 1px 7px 3px 7px; color: #7d8590;} "
    "listview {lines: 6; padding: 2px 1px; spacing: 1px;} "
    "element {padding: 4px 7px; border-radius: 6px; spacing: 6px;} "
    "element-icon {size: 16px;}",
    "-format",
    "i",
    "-kb-custom-1",
    "Control+Delete",
    "-kb-custom-2",
    "Control+Shift+Delete",
]

ICON_DIR = Path(tempfile.gettempdir()) / "cliphist-icons"

# These paste with Ctrl+Shift+V instead of Ctrl+V.
TERMINALS = (
    "kitty", "terminator", "alacritty", "foot", "konsole", "xterm", "uxterm",
    "wezterm", "tilix", "gnome-terminal", "kgx", "org.gnome.console",
    "qterminal", "st", "urxvt", "rxvt", "sakura", "terminology", "hyper",
    "tabby", "ghostty", "contour", "lilyterm",
)


def notify(summary: str, body: str) -> None:
    subprocess.run(
        ["notify-send", "-a", "Clipboard", summary, body],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def list_entries() -> list[str]:
    try:
        out = subprocess.check_output(
            ["cliphist", "list"], text=True, stderr=subprocess.DEVNULL
        )
    except (OSError, subprocess.CalledProcessError):
        return []
    return [line for line in out.splitlines() if line.strip()]


def image_thumbnail(entry_id: str) -> tuple[str | None, str | None]:
    """Return (icon_path, label) for an image entry, else (None, None)."""
    try:
        raw = subprocess.check_output(
            ["cliphist", "decode", entry_id], stderr=subprocess.DEVNULL
        )
    except (OSError, subprocess.CalledProcessError):
        return None, None

    try:
        from PIL import Image

        with Image.open(io.BytesIO(raw)) as im:
            width, height = im.size
            fmt = (im.format or "image").lower()
            thumb = im.copy()
            thumb.thumbnail((96, 96))

            ICON_DIR.mkdir(parents=True, exist_ok=True)
            icon = ICON_DIR / f"{entry_id}.png"
            thumb.save(icon)
            return str(icon), f"Image  {width}×{height}  ({fmt})"
    except Exception:
        return None, None


def active_class() -> str:
    try:
        out = subprocess.check_output(
            ["hyprctl", "activewindow", "-j"],
            text=True,
            stderr=subprocess.DEVNULL,
        )
        return (json.loads(out or "{}").get("class") or "").lower()
    except Exception:
        return ""


def auto_paste() -> None:
    """Send the paste shortcut to whichever window has focus (like Win+V)."""
    # Give Rofi a moment to close so focus returns to the app.
    time.sleep(0.3)

    mods = "CTRL SHIFT" if any(t in active_class() for t in TERMINALS) else "CTRL"
    expr = f'hl.dsp.send_shortcut({{ mods = "{mods}", key = "V" }})'
    subprocess.run(
        ["hyprctl", "dispatch", expr],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def build_payload(entries: list[str]) -> tuple[bytes, list[str]]:
    """Build Rofi's dmenu payload with embedded icons. Returns payload, labels."""
    payload = bytearray()
    labels: list[str] = []

    for line in entries:
        entry_id, _, preview = line.partition("\t")
        icon, label = image_thumbnail(entry_id)

        if label is not None:
            text = label
        elif "binary data" in preview:
            text = "Binary data"
        else:
            text = " ".join(preview.split())[:220]

        labels.append(text)
        payload += text.encode("utf-8", "replace")
        if icon:
            payload += b"\0icon\x1f" + icon.encode()
        else:
            # Give plain text entries a real icon instead of Rofi's blank default.
            payload += b"\0icon\x1ftext-x-generic"
        payload += b"\n"

    return bytes(payload), labels


def choose(payload: bytes) -> tuple[int, str] | None:
    proc = subprocess.run(
        ROFI,
        input=payload,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    # 1 = cancelled/Esc, 10 = Delete, 11 = Shift+Delete
    if proc.returncode not in (0, 10, 11):
        return None

    raw = proc.stdout.decode("utf-8", "replace").strip()
    try:
        index = int(raw)
    except ValueError:
        index = -1

    return proc.returncode, raw if index < 0 else str(index)


def main() -> None:
    entries = list_entries()
    if not entries:
        notify("Clipboard history", "Nothing copied yet.")
        return

    payload, labels = build_payload(entries)
    result = choose(payload)
    if result is None:
        return

    code, raw = result

    try:
        index = int(raw)
        if not 0 <= index < len(entries):
            index = labels.index(raw) if raw in labels else -1
    except ValueError:
        index = -1

    # Shift+Delete -> wipe everything (with confirmation)
    if code == 11:
        confirm = subprocess.run(
            [
                "rofi", "-dmenu", "-i", "-no-custom", "-no-show-icons",
                "-font", "JetBrains Mono 9",
                "-p", "Clear history?",
                "-theme-str", "window {width: 320px;} listview {lines: 2;}",
            ],
            input=b"Yes\nNo\n",
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if confirm.returncode == 0 and confirm.stdout.strip() == b"Yes":
            subprocess.run(["cliphist", "wipe"], check=False)
            shutil.rmtree(ICON_DIR, ignore_errors=True)
            notify("Clipboard history", "History cleared.")
        return

    if index < 0:
        return

    line = entries[index]
    entry_id = line.partition("\t")[0]

    # Delete the selected entry
    if code == 10:
        subprocess.run(
            ["cliphist", "delete"],
            input=(line + "\n").encode(),
            check=False,
        )
        return

    # Paste the selected entry back onto the clipboard
    try:
        data = subprocess.check_output(
            ["cliphist", "decode", entry_id], stderr=subprocess.DEVNULL
        )
    except (OSError, subprocess.CalledProcessError):
        notify("Clipboard history", "Could not read that entry.")
        return

    subprocess.run(["wl-copy"], input=data, check=False)
    auto_paste()


if __name__ == "__main__":
    main()

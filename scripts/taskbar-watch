#!/usr/bin/env python3
"""Per-workspace taskbar for Waybar.

Waybar's ``wlr/taskbar`` module shows every window on the output, no matter
which Hyprland workspace it belongs to. Hyprland's foreign-toplevel protocol
does not expose workspaces, so a taskbar cannot filter with it.

This daemon watches Hyprland's event socket, keeps a fixed set of Waybar
``image`` modules in sync with the windows on the *active* workspace, and
signals Waybar to refresh them.

Subcommands
-----------
    watch                run the event watcher (default)
    slot N               print the image path and tooltip for slot N
    click ACTION N       focus or close the window in slot N

The daemon writes to ``$XDG_CACHE_HOME/waybar-taskbar``::

    slot-N.png           rendered icon (transparent background)
    slot-N.path          path printed to Waybar's image module
    slot-N.tooltip       tooltip printed to Waybar's image module
    state.json           slot -> window address map used by click actions
"""

from __future__ import annotations

import fcntl
import json
import math
import os
import select
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

MAX_SLOTS = 10
WAYBAR_SIGNAL = 10  # SIGRTMIN+10, matched by "signal": 10 in Waybar
ICON_SIZE = 28  # logical pixels inside the icon canvas
CANVAS = 36  # 2x canvas, downscaled by Waybar to its "size": 18
ICON_CACHE_DIR = Path(
    os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))
) / "waybar-taskbar"

ICON_BASES = [Path.home() / ".local/share/icons", Path("/usr/share/icons")]
THEMES = [
    "Papirus",
    "Papirus-Dark",
    "Flat-Remix-Blue-Dark",
    "hicolor",
    "Adwaita",
    "HighContrast",
]
SIZES = [
    "512x512",
    "256x256",
    "128x128",
    "96x96",
    "64x64",
    "48x48",
    "32x32",
    "24x24",
    "22x22",
    "16x16",
    "scalable",
]
CATEGORIES = ["apps", "status", "places", "devices", "categories"]
EXTENSIONS = ["png", "svg", "xpm"]

DESKTOP_DIRS = [
    Path.home() / ".local/share/applications",
    Path("/usr/share/applications"),
    Path("/var/lib/flatpak/exports/share/applications"),
]


# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------


def cache_dir() -> Path:
    ICON_CACHE_DIR.mkdir(parents=True, exist_ok=True)
    return ICON_CACHE_DIR


def atomic_write(path: Path, data: str) -> None:
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(data)
    os.replace(tmp, path)


def hyprctl_json(*args: str) -> object:
    output = subprocess.check_output(
        ["hyprctl", *args, "-j"],
        text=True,
        stderr=subprocess.DEVNULL,
        timeout=3,
    )
    return json.loads(output) if output.strip() else {}


def signal_waybar() -> None:
    try:
        pids = subprocess.check_output(
            ["pgrep", "-x", "waybar"], text=True, stderr=subprocess.DEVNULL
        ).split()
    except (OSError, subprocess.CalledProcessError):
        return
    for raw in pids:
        try:
            os.kill(int(raw), signal.SIGRTMIN + WAYBAR_SIGNAL)
        except (OSError, ValueError):
            pass


# ---------------------------------------------------------------------------
# Icon discovery
# ---------------------------------------------------------------------------


def _variants(name: str) -> set[str]:
    return {
        name,
        name.lower(),
        name.upper(),
        name.capitalize(),
        name.replace("_", "-"),
        name.replace("-", "_"),
    }


def _find_icon(name: str) -> str | None:
    if not name:
        return None
    if Path(name).is_file():
        return name

    for base in ICON_BASES:
        for theme in THEMES:
            for size in SIZES:
                for category in CATEGORIES:
                    directory = base / theme / size / category
                    if not directory.is_dir():
                        continue
                    for variant in _variants(name):
                        for extension in EXTENSIONS:
                            candidate = directory / f"{variant}.{extension}"
                            if candidate.is_file():
                                return str(candidate)
    return None


_desktop_index: dict[str, str] | None = None


def _desktop_icon_name(window_class: str) -> str | None:
    """Map a Hyprland window class to the Icon= of its .desktop entry."""
    global _desktop_index
    if _desktop_index is None:
        by_wmclass: dict[str, str] = {}
        by_stem: dict[str, str] = {}
        for directory in DESKTOP_DIRS:
            if not directory.is_dir():
                continue
            for entry in directory.glob("*.desktop"):
                try:
                    text = entry.read_text(errors="ignore")
                except OSError:
                    continue
                icon = None
                wmclass = None
                for line in text.splitlines():
                    if line.startswith("Icon=") and icon is None:
                        icon = line.split("=", 1)[1].strip()
                    elif line.startswith("StartupWMClass=") and wmclass is None:
                        wmclass = line.split("=", 1)[1].strip().lower()
                if not icon:
                    continue
                by_stem.setdefault(entry.stem.lower(), icon)
                if wmclass:
                    by_wmclass.setdefault(wmclass, icon)
        _desktop_index = by_stem
        _desktop_index.update(
            {key: value for key, value in by_wmclass.items() if key not in _desktop_index}
        )

    klass = window_class.lower()
    return _desktop_index.get(klass)


_icon_map: dict[str, str] | None = None
_icon_map_file = ICON_CACHE_DIR / "icons.json"


def _load_icon_map() -> dict[str, str]:
    global _icon_map
    if _icon_map is None:
        try:
            data = json.loads(_icon_map_file.read_text())
            _icon_map = data if isinstance(data, dict) else {}
        except (OSError, ValueError):
            _icon_map = {}
    return _icon_map


def _save_icon_map() -> None:
    if _icon_map is None:
        return
    try:
        cache_dir()
        atomic_write(_icon_map_file, json.dumps(_icon_map, indent=0))
    except OSError:
        pass


def icon_for_class(window_class: str) -> str | None:
    mapping = _load_icon_map()
    klass = (window_class or "").strip()
    if not klass:
        return None

    cached = mapping.get(klass)
    if cached and Path(cached).is_file():
        return cached

    icon = _find_icon(klass)
    if not icon:
        desktop_icon = _desktop_icon_name(klass)
        if desktop_icon:
            icon = _find_icon(desktop_icon)

    if not icon:
        icon = _find_icon("application-default-icon")

    if icon:
        mapping[klass] = icon
        _save_icon_map()
    return icon


# ---------------------------------------------------------------------------
# Icon rendering
# ---------------------------------------------------------------------------

_pixbuf_cache: dict[tuple[str, int], object | None] = {}


def _load_pixbuf(path: str, size: int):
    key = (path, size)
    if key in _pixbuf_cache:
        return _pixbuf_cache[key]

    try:
        import gi

        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import GdkPixbuf

        pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, size, size, True)
    except Exception:
        pixbuf = None

    _pixbuf_cache[key] = pixbuf
    return pixbuf


def _rounded_rect(cr, x: float, y: float, w: float, h: float, r: float) -> None:
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def render_icon(icon_path: str | None, output: Path, active: bool, hidden: bool) -> None:
    import cairo
    import gi

    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk

    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, CANVAS, CANVAS)
    cr = cairo.Context(surface)

    if active or hidden:
        _rounded_rect(cr, 0.5, 0.5, CANVAS - 1, CANVAS - 1, 8)
        if active:
            cr.set_source_rgba(51 / 255, 204 / 255, 255 / 255, 0.16)
        else:
            cr.set_source_rgba(255, 255, 255, 0.06)
        cr.fill()

    pixbuf = _load_pixbuf(icon_path, ICON_SIZE) if icon_path else None
    if pixbuf is not None:
        x = (CANVAS - pixbuf.get_width()) / 2
        y = (CANVAS - pixbuf.get_height()) / 2
        Gdk.cairo_set_source_pixbuf(cr, pixbuf, x, y)
        if hidden:
            cr.paint_with_alpha(0.45)
        else:
            cr.paint()
    else:
        # Last-resort placeholder: a rounded plate with a dot.
        _rounded_rect(cr, 8, 8, CANVAS - 16, CANVAS - 16, 5)
        cr.set_source_rgba(255, 255, 255, 0.16)
        cr.fill()

    if active:
        _rounded_rect(cr, 6, CANVAS - 4, CANVAS - 12, 3, 1.5)
        cr.set_source_rgba(51 / 255, 204 / 255, 255 / 255, 1)
        cr.fill()

    tmp = output.with_name(f".{output.name}.{os.getpid()}.tmp")
    surface.write_to_png(str(tmp))
    os.replace(tmp, output)


# ---------------------------------------------------------------------------
# State rendering
# ---------------------------------------------------------------------------


def _workspace_id(window: dict) -> int | None:
    workspace = window.get("workspace") or {}
    value = workspace.get("id")
    return value if isinstance(value, int) else None


def _clean_title(value: str) -> str:
    return " ".join((value or "").split())


def render() -> None:
    directory = cache_dir()
    (directory / "empty.png").unlink(missing_ok=True)

    clients = hyprctl_json("clients")
    if not isinstance(clients, list):
        clients = []

    active_workspace = hyprctl_json("activeworkspace")
    workspace_id = active_workspace.get("id") if isinstance(active_workspace, dict) else None

    active_window = hyprctl_json("activewindow")
    active_address = (
        active_window.get("address") if isinstance(active_window, dict) else None
    )

    windows = [w for w in clients if _workspace_id(w) == workspace_id]

    previous = {}
    state_file = directory / "state.json"
    try:
        previous = json.loads(state_file.read_text())
    except (OSError, ValueError):
        previous = {}

    # Leave the icons alone when nothing that affects the bar has changed.
    signature = (
        workspace_id,
        active_address,
        [
            (
                w.get("address"),
                w.get("class") or w.get("initialClass") or "",
                w.get("title") or "",
                bool(w.get("hidden")),
            )
            for w in windows
        ],
    )
    if previous.get("signature") == list(signature):
        return

    slots = []
    for index in range(MAX_SLOTS):
        icon_file = directory / f"slot-{index}.png"
        path_file = directory / f"slot-{index}.path"
        tooltip_file = directory / f"slot-{index}.tooltip"

        if index >= len(windows):
            icon_file.unlink(missing_ok=True)
            atomic_write(path_file, str(directory / "empty.png"))
            atomic_write(tooltip_file, "")
            continue

        window = windows[index]
        klass = (window.get("class") or window.get("initialClass") or "").strip()
        title = _clean_title(window.get("title") or "")
        address = window.get("address") or ""
        hidden = bool(window.get("hidden"))
        is_active = bool(address) and address == active_address

        icon_path = icon_for_class(klass)
        try:
            render_icon(icon_path, icon_file, is_active, hidden)
            visible_path = str(icon_file)
        except Exception as error:
            print(f"taskbar-watch: cannot render {klass}: {error}", file=sys.stderr)
            icon_file.unlink(missing_ok=True)
            visible_path = str(directory / "empty.png")

        atomic_write(path_file, visible_path)
        atomic_write(tooltip_file, title or klass or "Window")
        slots.append(
            {
                "slot": index,
                "address": address,
                "class": klass,
                "title": title,
            }
        )

    state = {
        "workspace": workspace_id,
        "active": active_address,
        "signature": list(signature),
        "slots": slots,
    }
    atomic_write(state_file, json.dumps(state))
    signal_waybar()


# ---------------------------------------------------------------------------
# Waybar / click interface
# ---------------------------------------------------------------------------


def slot_output(index: int) -> None:
    directory = cache_dir()
    path_file = directory / f"slot-{index}.path"
    tooltip_file = directory / f"slot-{index}.tooltip"

    try:
        path = path_file.read_text().strip()
    except OSError:
        path = ""
    if not path:
        path = str(directory / "empty.png")

    print(path)
    try:
        tooltip = tooltip_file.read_text().strip()
    except OSError:
        tooltip = ""
    if tooltip:
        print(tooltip)


def click(action: str, index: int) -> None:
    directory = cache_dir()
    try:
        state = json.loads((directory / "state.json").read_text())
    except (OSError, ValueError):
        return

    entry = next(
        (slot for slot in state.get("slots", []) if slot.get("slot") == index),
        None,
    )
    address = (entry or {}).get("address")
    if not address:
        return

    try:
        clients = hyprctl_json("clients")
    except Exception:
        return
    if not any(w.get("address") == address for w in clients):
        return

    selector = f"address:{address}"
    if action == "focus":
        expression = f'hl.dsp.focus({{ window = "{selector}" }})'
    elif action == "close":
        expression = f'hl.dsp.window.close({{ window = "{selector}" }})'
    elif action == "float":
        expression = (
            f'hl.dsp.window.float({{ action = "toggle", window = "{selector}" }})'
        )
    else:
        return

    subprocess.run(
        ["hyprctl", "dispatch", expression],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


# ---------------------------------------------------------------------------
# Event watcher
# ---------------------------------------------------------------------------

RELEVANT_EVENTS = {
    "openwindow",
    "closewindow",
    "movewindow",
    "workspace",
    "createworkspace",
    "destroyworkspace",
    "moveworkspace",
    "renameworkspace",
    "activewindow",
    "activewindowv2",
    "focusedmon",
    "fullscreen",
    "changefloatingmode",
    "changefloatingstate",
    "urgent",
    "minimized",
    "togglegroup",
    "moveintogroup",
    "moveoutofgroup",
    "pin",
    "monitoradded",
    "monitorremoved",
}

_render_error_logged = False


def _safe_render() -> None:
    global _render_error_logged
    try:
        render()
        _render_error_logged = False
    except Exception as error:  # Hyprland may be restarting
        if not _render_error_logged:
            print(f"taskbar-watch: render failed: {error}", file=sys.stderr)
            _render_error_logged = True


def _event_socket() -> Path | None:
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    base = runtime / "hypr"
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if signature:
        candidate = base / signature / ".socket2.sock"
        if candidate.exists():
            return candidate
    try:
        candidates = sorted(
            base.glob("*/.socket2.sock"), key=lambda item: item.stat().st_mtime
        )
    except OSError:
        return None
    return candidates[-1] if candidates else None


def watch() -> None:
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/tmp/waybar-taskbar-{os.getuid()}"))
    runtime.mkdir(parents=True, exist_ok=True)
    lock_path = runtime / "waybar-taskbar.lock"
    lock = open(lock_path, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return
    lock.write(str(os.getpid()))
    lock.flush()

    _safe_render()

    while True:
        socket_path = _event_socket()
        if not socket_path:
            time.sleep(2)
            continue

        connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            connection.connect(str(socket_path))
        except OSError:
            connection.close()
            time.sleep(1)
            continue

        connection.setblocking(False)
        buffer = b""
        pending = True
        last_render = 0.0

        try:
            while True:
                readable, _, _ = select.select([connection], [], [], 0.2)
                if readable:
                    chunk = connection.recv(65536)
                    if not chunk:
                        break
                    buffer += chunk
                    while b"\n" in buffer:
                        raw, buffer = buffer.split(b"\n", 1)
                        event = raw.decode("utf-8", "replace").split(">>", 1)[0]
                        if event in RELEVANT_EVENTS:
                            pending = True

                if pending and time.monotonic() - last_render >= 0.08:
                    _safe_render()
                    pending = False
                    last_render = time.monotonic()
        except OSError:
            pass
        finally:
            connection.close()

        # Hyprland restarted or the socket went away: reconnect and refresh.
        time.sleep(0.5)


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------


def usage() -> None:
    print(
        "usage: taskbar-watch [watch | slot N | click focus|close|float N]",
        file=sys.stderr,
    )


def main() -> None:
    args = sys.argv[1:]
    if not args or args[0] in {"watch", "daemon"}:
        watch()
    elif args[0] == "slot" and len(args) == 2:
        try:
            slot_output(int(args[1]))
        except ValueError:
            usage()
            raise SystemExit(1)
    elif args[0] == "click" and len(args) == 3:
        try:
            click(args[1], int(args[2]))
        except ValueError:
            usage()
            raise SystemExit(1)
    elif args[0] in {"-h", "--help"}:
        usage()
    else:
        usage()
        raise SystemExit(1)


if __name__ == "__main__":
    main()

# ---------------------------------------------------------------------------
# Bikram Sambat (Nepali) date support
#
# Calendar data: 1975-2100 B.S., where 1975-01-01 B.S. == 1918-04-13 A.D.
# Month lengths are stored per year because B.S. months are not fixed length.
# ---------------------------------------------------------------------------

BS_DATA_FILE = Path.home() / ".local/share/clock-popup/calendar_bs.csv"
BS_EPOCH = dt.date(1918, 4, 13)

BS_MONTHS_NP = (
    "वैशाख", "जेष्ठ", "असार", "श्रावण", "भदौ", "आश्विन",
    "कार्तिक", "मंसिर", "पौष", "माघ", "फाल्गुण", "चैत्र",
)
BS_MONTHS_EN = (
    "Baishakh", "Jestha", "Asar", "Shrawan", "Bhadau", "Aswin",
    "Kartik", "Mangsir", "Poush", "Magh", "Falgun", "Chaitra",
)
BS_DAYS_NP = (
    "सोमबार", "मंगलबार", "बुधबार", "बिहिबार",
    "शुक्रबार", "शनिबार", "आइतबार",
)
NP_DIGITS = str.maketrans("0123456789", "०१२३४५६७८९")
NEPAL_TZ = ZoneInfo("Asia/Kathmandu")


def load_bs_data() -> dict[int, list[int]]:
    data: dict[int, list[int]] = {}
    try:
        with BS_DATA_FILE.open(newline="") as handle:
            for row in csv.reader(handle):
                if not row or row[0].strip() == "Year":
                    continue
                data[int(row[0])] = [int(value) for value in row[1:13]]
    except Exception:
        pass
    return data


BS_DATA = load_bs_data()


def ad_to_bs(day: dt.date) -> tuple[int, int, int] | None:
    """Convert an A.D. date to a (year, month, day) Bikram Sambat tuple."""
    if not BS_DATA:
        return None

    remaining = (day - BS_EPOCH).days
    if remaining < 0:
        return None

    year = min(BS_DATA)
    while year in BS_DATA:
        months = BS_DATA[year]
        if remaining < sum(months):
            break
        remaining -= sum(months)
        year += 1
    else:
        return None

    month = 0
    while remaining >= BS_DATA[year][month]:
        remaining -= BS_DATA[year][month]
        month += 1

    return year, month + 1, remaining + 1


def bs_to_ad(year: int, month: int, day: int = 1) -> dt.date | None:
    """Convert a Bikram Sambat date back to an A.D. date."""
    if year not in BS_DATA or not 1 <= month <= 12:
        return None
    days = sum(sum(BS_DATA[y]) for y in range(min(BS_DATA), year))
    days += sum(BS_DATA[year][: month - 1]) + (day - 1)
    return BS_EPOCH + dt.timedelta(days=days)


def bs_month_length(year: int, month: int) -> int:
    if year not in BS_DATA:
        return 0
    return BS_DATA[year][month - 1]


class ClockPopup(Gtk.Window):
    def __init__(self) -> None:
        super().__init__(title="Clock")
        self.set_name("clock-popup")
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_keep_above(True)
        self.set_default_size(330, 315)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual and screen.is_composited():
            self.set_visual(visual)

        self._day: dt.date | None = None
        self._bs_text = "B.S. --"

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_margin_top(14)
        box.set_margin_bottom(12)
        box.set_margin_start(16)
        box.set_margin_end(16)
        self.add(box)

        self.time_label = Gtk.Label()
        self.time_label.set_name("time")
        self.time_label.set_halign(Gtk.Align.START)

        self.date_label = Gtk.Label()
        self.date_label.set_name("date")
        self.date_label.set_halign(Gtk.Align.START)

        self.nepali_label = Gtk.Label()
        self.nepali_label.set_name("nepali")
        self.nepali_label.set_halign(Gtk.Align.START)

        self.details_label = Gtk.Label()
        self.details_label.set_name("details")
        self.details_label.set_halign(Gtk.Align.START)

        # --- A.D. calendar page ---
        self.calendar = Gtk.Calendar()
        self.calendar.set_display_options(
            Gtk.CalendarDisplayOptions.SHOW_HEADING
            | Gtk.CalendarDisplayOptions.SHOW_DAY_NAMES
        )

        # --- B.S. (Bikram Sambat) calendar page ---
        self._bs_year = 0
        self._bs_month = 0
        self._bs_today: tuple[int, int, int] | None = None

        bs_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        bs_page.add_events(Gdk.EventMask.SCROLL_MASK)
        bs_page.connect("scroll-event", self._on_bs_scroll)

        nav = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2)

        self.bs_prev = Gtk.Button(label="‹")
        self.bs_next = Gtk.Button(label="›")
        for button in (self.bs_prev, self.bs_next):
            button.set_relief(Gtk.ReliefStyle.NONE)
            button.set_can_focus(False)
            button.get_style_context().add_class("bs-arrow")

        self.bs_heading = Gtk.Label()
        self.bs_heading.set_hexpand(True)
        self.bs_heading.set_halign(Gtk.Align.CENTER)
        self.bs_heading.set_tooltip_text("Back to today")
        self.bs_heading.get_style_context().add_class("bs-heading")

        nav.pack_start(self.bs_prev, False, False, 0)
        nav.pack_start(self.bs_heading, True, True, 0)
        nav.pack_end(self.bs_next, False, False, 0)
        bs_page.pack_start(nav, False, False, 0)

        self.bs_grid = Gtk.Grid()
        self.bs_grid.set_column_homogeneous(True)
        self.bs_grid.set_row_homogeneous(True)
        self.bs_grid.set_column_spacing(2)
        self.bs_grid.set_row_spacing(1)
        bs_page.pack_start(self.bs_grid, True, True, 0)

        self.bs_prev.connect("clicked", lambda *_: self._shift_bs_month(-1))
        self.bs_next.connect("clicked", lambda *_: self._shift_bs_month(1))
        self.bs_heading.connect(
            "button-press-event", lambda *_: self._bs_reset_to_today()
        )

        # --- A.D. / B.S. switcher ---
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.NONE)
        self.stack.add_titled(self.calendar, "ad", "A.D.")
        self.stack.add_titled(bs_page, "bs", "B.S.")

        self.switcher = Gtk.StackSwitcher(stack=self.stack)
        self.switcher.set_halign(Gtk.Align.END)
        self.switcher.set_valign(Gtk.Align.CENTER)
        self.switcher.set_can_focus(False)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        header.pack_start(self.time_label, False, False, 0)
        header.pack_end(self.switcher, False, False, 0)

        box.pack_start(header, False, False, 0)
        box.pack_start(self.date_label, False, False, 0)
        box.pack_start(self.nepali_label, False, False, 0)
        box.pack_start(self.details_label, False, False, 0)
        box.pack_start(Gtk.Separator(), False, False, 2)
        box.pack_start(self.stack, True, True, 0)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self.connect("destroy", Gtk.main_quit)
        self.connect("focus-out-event", self._on_focus_out)
        self.connect("key-press-event", self._on_key_press)

        self._tick()

    def _tick(self) -> bool:
        now = dt.datetime.now().astimezone()

        self.time_label.set_text(now.strftime("%H:%M:%S"))

        if now.date() != self._day:
            self._day = now.date()
            self.date_label.set_text(now.strftime("%A, %d %B %Y"))

            bs = ad_to_bs(now.date())
            if bs:
                bs_year, bs_month, bs_day = bs
                nepali = (
                    f"वि.सं. {bs_year} {BS_MONTHS_NP[bs_month - 1]} {bs_day}"
                ).translate(NP_DIGITS)
                self.nepali_label.set_text(
                    f"{nepali} {BS_DAYS_NP[now.weekday()]}"
                )
                self._bs_text = f"B.S. {bs_year}/{bs_month:02d}/{bs_day:02d}"
                self._bs_today = bs
                self._bs_set_view(bs_year, bs_month)
            else:
                self.nepali_label.set_text("B.S. date unavailable")
                self._bs_text = "B.S. --"
                self._bs_today = None

            self.calendar.select_month(now.month - 1, now.year)
            self.calendar.select_day(now.day)

        nepal = dt.datetime.now(NEPAL_TZ)
        iso = now.isocalendar()
        self.details_label.set_text(
            f"{self._bs_text}   ·   ISO week {iso.week}"
            f"   ·   {nepal:%H:%M} NPT"
        )

        return True

    # --- Bikram Sambat calendar navigation --------------------------------

    def _bs_set_view(self, year: int, month: int) -> None:
        if not BS_DATA:
            return

        low, high = min(BS_DATA), max(BS_DATA)
        while month < 1:
            month += 12
            year -= 1
        while month > 12:
            month -= 12
            year += 1
        year = max(low, min(high, year))

        self._bs_year, self._bs_month = year, month
        self._render_bs_grid()

    def _shift_bs_month(self, delta: int) -> None:
        if BS_DATA:
            self._bs_set_view(self._bs_year, self._bs_month + delta)

    def _bs_reset_to_today(self) -> None:
        if self._bs_today:
            self._bs_set_view(self._bs_today[0], self._bs_today[1])

    def _on_bs_scroll(self, _widget, event) -> bool:
        if event.direction == Gdk.ScrollDirection.UP:
            self._shift_bs_month(-1)
            return True
        if event.direction == Gdk.ScrollDirection.DOWN:
            self._shift_bs_month(1)
            return True
        return False

    def _render_bs_grid(self) -> None:
        if not BS_DATA or not self._bs_year:
            return

        for child in self.bs_grid.get_children():
            self.bs_grid.remove(child)

        year, month = self._bs_year, self._bs_month

        self.bs_heading.set_text(
            f"{BS_MONTHS_NP[month - 1]} {str(year).translate(NP_DIGITS)}"
        )

        weekdays = ("आइत", "सोम", "मंगल", "बुध", "बिही", "शुक्र", "शनि")
        for column, name in enumerate(weekdays):
            label = Gtk.Label(label=name)
            label.get_style_context().add_class("bs-weekday")
            self.bs_grid.attach(label, column, 0, 1, 1)

        first_day = bs_to_ad(year, month, 1)
        start_column = (first_day.weekday() + 1) % 7 if first_day else 0
        length = bs_month_length(year, month)

        prev_year, prev_month = (
            (year, month - 1) if month > 1 else (year - 1, 12)
        )
        next_year, next_month = (
            (year, month + 1) if month < 12 else (year + 1, 1)
        )
        prev_length = bs_month_length(prev_year, prev_month)
        next_length = bs_month_length(next_year, next_month)

        today = self._bs_today
        for index in range(42):
            offset = index - start_column
            other = False

            if offset < 0:
                day = prev_length + offset + 1
                other = True
                valid = bool(prev_length) and 0 < day <= prev_length
            elif offset >= length:
                day = offset - length + 1
                other = True
                valid = bool(next_length) and 0 < day <= next_length
            else:
                day = offset + 1
                valid = True

            text = str(day).translate(NP_DIGITS) if valid else ""
            cell = Gtk.Label(label=text)
            context = cell.get_style_context()
            context.add_class("bs-day")
            if other and valid:
                context.add_class("bs-other")
            if valid and not other and today and (year, month, day) == today:
                context.add_class("bs-today")

            self.bs_grid.attach(cell, index % 7, index // 7 + 1, 1, 1)

        self.bs_grid.show_all()

    def _on_focus_out(self, *_args) -> bool:
        GLib.timeout_add(120, self._close_if_unfocused)
        return False

    def _close_if_unfocused(self) -> bool:
        if not self.is_active():
            self.destroy()
        return False

    def _on_key_press(self, _widget, event) -> bool:
        if event.keyval == Gdk.KEY_Escape:
            self.destroy()
            return True

        if self.stack.get_visible_child_name() == "bs":
            if event.keyval == Gdk.KEY_Left:
                self._shift_bs_month(-1)
                return True
            if event.keyval == Gdk.KEY_Right:
                self._shift_bs_month(1)
                return True
            if event.keyval in (Gdk.KEY_Home, Gdk.KEY_t):
                self._bs_reset_to_today()
                return True

        return False


def main() -> None:
    popup = ClockPopup()
    popup.show_all()

    # Allow starting on the Bikram Sambat page (handy for scripting/testing).
    if os.environ.get("CLOCK_POPUP_VIEW", "ad").strip().lower() == "bs":
        popup.stack.set_visible_child_name("bs")

    popup.present_with_time(Gtk.get_current_event_time())
    Gtk.main()


if __name__ == "__main__":
    main()

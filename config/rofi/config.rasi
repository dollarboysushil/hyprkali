configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Flat-Remix-Teal-Dark";
    terminal: "terminator";
    font: "JetBrains Mono 11";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
    drun-display-format: "{name}";
    sorting-method: "fzf";
}

@theme "hypr"

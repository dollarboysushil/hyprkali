general {
    hide_cursor = true
}

background {
    monitor =
    path = @WALLPAPER@
    color = rgba(5, 7, 10, 0.9)
    blur_passes = 2
    blur_size = 6
    brightness = 0.75
    contrast = 0.95
}

label {
    monitor =
    text = cmd[update:1000] date +"%H:%M"
    color = rgb(e6edf3)
    font_size = 88
    font_family = JetBrains Mono
    position = 0, 160
    halign = center
    valign = center
    shadow_passes = 2
    shadow_size = 8
    shadow_color = rgba(0, 0, 0, 0.6)
}

label {
    monitor =
    text = cmd[update:60000] date +"%A, %d %B"
    color = rgb(51, 204, 255)
    font_size = 15
    font_family = JetBrains Mono
    position = 0, 105
    halign = center
    valign = center
}

label {
    monitor =
    text = <span size="large">Welcome back, $USER</span>
    color = rgb(c9d1d9)
    font_size = 16
    font_family = JetBrains Mono
    position = 0, 300
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 320, 52
    outline_thickness = 2
    rounding = 12
    dots_size = 0.22
    dots_spacing = 0.3
    dots_center = true
    outer_color = rgb(51, 204, 255)
    inner_color = rgb(13, 17, 23)
    font_color = rgb(c9d1d9)
    placeholder_text = <i>Enter password…</i>
    fail_text = <i><span color="#ff5f56">Wrong password</span></i>
    fade_on_empty = false
    position = 0, -30
    halign = center
    valign = center
}
